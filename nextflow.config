params {
  inputFilePath = "$baseDir/data/Data.fa"
  outputDir = "$launchDir/output"
  outputFileName = "output_scanned.txt"
  outputGFFName = "output_scanned.gff"
  fastaSubsetSize = 1

  // Filtering
  // applyHighConfFilter = true  -> strictFilter (pseudo/mismatch/anticodon/trunc
  //   checks + Inf score >= minInfScore + anticodon type must match isotype model)
  // applyHighConfFilter = false -> simpleFilter (drop pseudo + Inf score cutoff only)
  applyHighConfFilter = false
  minInfScore = 60
}
profiles {
  docker {
    includeConfig "$baseDir/conf/docker.config"
  }
  singularity {
    includeConfig "$baseDir/conf/singularity.config"
  }
  lsf {
    includeConfig "$baseDir/conf/lsf.config"
  }
}
